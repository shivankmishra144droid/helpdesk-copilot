# Copy to .env and fill in what you use. Everything here is optional:
# without an LLM provider the app still works and drafts from KB templates.

# --- AI drafting provider -------------------------------------------------
# auto (default) | anthropic | openai | ollama | none
LLM_PROVIDER=auto

# Claude (used automatically when the key is set and LLM_PROVIDER=auto)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# OpenAI (both values required)
OPENAI_API_KEY=
OPENAI_MODEL=

# Local Ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# --- Search ---------------------------------------------------------------
# hybrid (default) | xgboost | cross_encoder | disabled   (see benchmarks/results.md)
# RERANKING_MODE=hybrid
# CROSS_ENCODER_ENABLED=false

# --- Security -------------------------------------------------------------
# Public-demo restrictions: block uploads, re-imports and destructive category changes.
# DEMO_MODE=false

# If set, write requests must send a matching X-API-Token header
# (set NEXT_PUBLIC_API_TOKEN in frontend/.env.local to the same value).
# COPILOT_API_TOKEN=
